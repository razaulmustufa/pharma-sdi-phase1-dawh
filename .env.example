# Example only. Copy this file to .env locally, then replace every placeholder.
# NEVER commit the real .env file to GitHub.

# Keep these usernames/database names aligned with docker-compose.yaml.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_URL_SAFE_PASSWORD

# Airflow cryptographic secrets (generate real values locally; do not use these placeholders).
FERNET_KEY=GENERATE_A_VALID_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Initial Airflow web administrator credentials.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Optional local settings.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.4.0
