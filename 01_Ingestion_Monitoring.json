            "type": "grafana-postgresql-datasource",
            "uid": "bg52onhbuzxtsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::bigint AS value FROM ops.batch_load_log WHERE $__timeFilter(attempted_at)",
          "refId": "A"
