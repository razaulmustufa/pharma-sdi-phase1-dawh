            "uid": "bg52onhbuzxtsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::bigint AS value FROM ops.query_log WHERE $__timeFilter(executed_at)",
          "refId": "A"
