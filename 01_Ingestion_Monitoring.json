    {
      "id": 2,
      "title": "Batch Success Rate",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg52onhbuzxtsf"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg52onhbuzxtsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(ROUND(100.0 * COUNT(*) FILTER (WHERE status='success') / NULLIF(COUNT(*),0),2),0)::double precision AS value FROM ops.batch_load_log WHERE $__timeFilter(attempted_at)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
