          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT relname AS table_name, ROUND((pg_total_relation_size(relid)::numeric/1048576),2)::double precision AS size_mb FROM pg_stat_user_tables WHERE schemaname='mart' ORDER BY size_mb DESC",
